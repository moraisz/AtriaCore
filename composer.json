{
    "name": "moraisz/atria-core",
    "description": "Core runtime for the Atria PHP framework.",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "pestphp/pest": "^5.1",
        "phpstan/phpstan": "^2.2"
    },
    "suggest": {
        "ext-pgsql": "Required by the pgsql database driver.",
        "ext-mysqli": "Required by the mysql and mariadb database drivers.",
        "ext-sqlite3": "Required by the sqlite database driver."
    },
    "autoload": {
        "psr-4": {
            "Atria\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/atria"
    ],
    "scripts": {
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "phpstan": "phpstan analyse --memory-limit=2G",
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
