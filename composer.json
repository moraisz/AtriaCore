{
    "name": "moraisz/atria-core",
    "description": "Core runtime for the Atria PHP framework.",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "pestphp/pest": "^4.7",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Atria\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/atria"
    ],
    "scripts": {
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "phpstan": "phpstan analyse --memory-limit=2G",
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
